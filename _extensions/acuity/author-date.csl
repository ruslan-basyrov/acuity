<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only">
  
  <info>
    <title>Acuity Author-Date</title>
    <id>https://github.com/ruslan-basyrov/acuity/styles/author-date</id>
    <link href="https://github.com/ruslan-basyrov/acuity/styles/author-date" rel="self"/>
    <author>
      <name>Ruslan Basyrov</name>
    </author>
    <category citation-format="author-date"/>
    <updated>2026-03-11T00:00:00+00:00</updated>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". "
            and="text" delimiter-precedes-last="always"/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text"/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="title">
    <text variable="title" font-style="italic"/>
  </macro>

  <macro name="access">
    <choose>
      <if variable="URL">
        <group prefix="[" suffix="]">
          <text value="URL: "/>
          <text variable="URL"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- Data is listed and numbered apart from the literature, so it is cited by
       its number there rather than by author and year, which for a dataset are
       the depositor and the edition. -->
  <macro name="category">
    <choose>
      <if type="dataset">
        <text value="2"/>
      </if>
      <else-if type="software">
        <text value="3"/>
      </else-if>
      <else>
        <text value="1"/>
      </else>
    </choose>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true"
            collapse="citation-number">
    <!-- Collapsing joins a run of numbers, which the keys have to be in. -->
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <choose>
        <if type="dataset software">
          <text variable="citation-number"/>
        </if>
        <else>
          <group delimiter=", ">
            <text macro="author-short"/>
            <date variable="issued" form="numeric" date-parts="year"/>
            <group delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </group>
        </else>
      </choose>
    </layout>
  </citation>

  <!-- The entries are numbered, and the number is set apart as its own field so
       that each format can hang the link back to the first mention on it. -->
  <bibliography second-field-align="flush">
    <sort>
      <key macro="category"/>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" suffix="."/>
      <group delimiter=". ">
        <text macro="author"/>
        <date variable="issued" form="numeric" date-parts="year"/>
        <text macro="title"/>
        <text macro="access"/> </group>
    </layout>
  </bibliography>

</style>
